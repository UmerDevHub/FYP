{
  "name": "vehicle360",
  "version": "0.1.0",
  "description": "Vehicle 360: multi-branch car dealership system for AK Motors (final year project)",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migrate": "npm run migrate -w apps/api --if-present",
    "seed": "npm run seed -w apps/api --if-present",
    "demo:reset": "npm run demo:reset -w apps/api --if-present",
    "job:expire": "npm run job:expire -w apps/api --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.16.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
