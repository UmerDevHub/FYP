# Copy this file to apps/api/.env and put your own values there. Never commit .env.
# Every value below is fake.
PORT=3100
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# Development database
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/vehicle360_dev
# Test database: the name must end in _test
TEST_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/vehicle360_test

# Secrets added in later slices (login in S2). Use long random values in .env.
JWT_ACCESS_SECRET=CHANGE_ME
