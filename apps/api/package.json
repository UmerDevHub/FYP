{
  "name": "@vehicle360/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=.env ../../node_modules/knex/bin/cli.js migrate:latest",
    "seed": "node --env-file-if-exists=.env ../../node_modules/knex/bin/cli.js seed:run"
  },
  "dependencies": {
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7",
    "@v360/shared": "0.1.0"
  },
  "devDependencies": {
    "supertest": "^7.3.2",
    "vitest": "^5.1.2"
  }
}
